SYMBOLS=IONQ,NVDA
# SYMBOLS is legacy: on first run an empty tracked_symbols table is seeded
# from it, afterwards symbols are managed in the DB at /admin/symbols.
STOCK_INFO_RUN_WHEN_MARKET_CLOSED=false
# Collector cadence in milliseconds. Values below 60000 are rejected.
STOCK_INFO_INTERVAL_MS=300000
REDDIT_SENTIMENT_INTERVAL_MS=900000
POLYMARKET_INTERVAL_MS=900000
# Keep schedulers out of the web process; Docker already starts workers.ts.
RUN_SCHEDULERS_IN_WEB_PROCESS=false
MAC_NOTIFICATION_SYMBOLS=IONQ

# Docker runs OpenCode as a service with its own persistent Docker data volume.
# Local development uses the `opencode` CLI when OPENCODE_SERVER_URL is unset.
# OPENCODE_MODEL defaults to muse-spark-1.3-contributor-free (Muse Spark 1.3 Free).
# Set OPENCODE_DISABLED=true or OPENCODE_MODEL=none to skip LLM analysis.
# OPENCODE_API_KEY and OPENCODE_BASE_URL are legacy and no longer used.
OPENCODE_MODEL=muse-spark-1.3-contributor-free
# OPENCODE_CLI_PATH=opencode
# Password for the internal OpenCode service and app connection.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-with-a-random-secret
# OPENCODE_DISABLED=false

# LLM_DOCUMENT_MAX_CHARS=50000
# LLM_MAX_OUTPUT_TOKENS=600
# LLM_TIMEOUT_MS=60000
# STOCK_CHAT_RATE_LIMIT_SALT=replace-with-a-random-secret
# STOCK_CHAT_TRUST_PROXY_HEADERS=false

# Reddit monitoring uses Puppeteer and does not require Reddit API credentials.
# REDDIT_TIMEOUT_MS=60000
# POLYMARKET_TIMEOUT_MS=60000

# Local libSQL (sqld) in Docker, persisted in ./data next to the Dockerfile.
# - Host-side commands (`npm run dev`, `npm run workers:start`): http://localhost:8080
# - Inside `docker compose`, the app service overrides this with http://db:8080.
DATABASE_URL=http://localhost:8080
# Optional: sqld runs without auth by default.
DATABASE_AUTH_TOKEN=

# Auth (OTP login with user roles admin/user/guest).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-a-random-string-at-least-32-chars
# Comma-separated emails auto-promoted to admin on login.
ADMIN_EMAILS=you@example.com
# OTP emails are sent with Resend.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=login@yourdomain.com
