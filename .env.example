SYMBOLS=IONQ,NVDA
STOCK_INFO_RUN_WHEN_MARKET_CLOSED=false

# Leave OPENROUTER_API_KEY and OPENROUTER_MODEL unset to skip LLM analysis.
OPENROUTER_API_KEY=sk-key
OPENROUTER_MODEL=openrouter/owl-alpha

# LLM_DOCUMENT_MAX_CHARS=50000
# LLM_MAX_OUTPUT_TOKENS=1200
# LLM_TIMEOUT_MS=60000

TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_database_auth_token
# Optional: Turso Platform API token, used only to create/manage database tokens.
# TURSO_PLATFORM_TOKEN=your_turso_platform_api_token
